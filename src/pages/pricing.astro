---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../layouts/BaseLayout.astro';
import CornerLines from '../components/CornerLines.astro';
import { imgSet } from '../lib/sanity/image';
import { absUrl } from '../lib/seo/site';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import CtaSection from '../components/CtaSection.astro';
import RetainerShowcase from '../components/RetainerShowcase.astro';
import ProcessSection from '../components/ProcessSection.astro';
import { SITE_SETTINGS_QUERY, HOME_QUERY } from '../lib/sanity/queries';
import {
  projectPlans,
  retainerPlans,
  planCompareRows,
  pricingFaqs,
  currencies,
  priceParts,
  type Plan,
} from '../lib/pricing';
import '../styles/pricing.css';

const [settings, home] = await Promise.all([
  sanityClient.fetch(SITE_SETTINGS_QUERY),
  sanityClient.fetch(HOME_QUERY),
]);
// Same testimonials as the Case Studies page: video first, then text
const testimonials = [...(home?.videoTestimonials ?? []), ...(home?.textTestimonials ?? [])];
const ogImage = imgSet(settings?.defaultOgImage, { width: 1200 })?.src;
const description =
  'Starting prices for Webflow websites, redesigns and migrations, plus monthly plans after launch. Small sites from $5,000, retainers from $1,900 a month.';

const tabs: { id: string; label: string; plans: Plan[] }[] = [
  { id: 'projects', label: 'One-time projects', plans: projectPlans },
  { id: 'retainers', label: 'Monthly retainers', plans: retainerPlans },
];
---

<BaseLayout
  seo={{
    title: 'SRDJAN JOVIC · Pricing',
    description,
    canonical: absUrl('/pricing'),
    ogImage,
  }}
>
  <!-- Pricing hero and plans START -->
  <section class="section_pricing">
    <div class="container-large">
      <div class="side_lines">
        <div class="padding-global padding-section-large">
          <div class="pricing_hero">
            <div class="text_in-exprecions">
              <div class="exprecion">[</div>
              <div class="text-color-alternate text-size-regular text-style-allcaps">pricing</div>
              <div class="exprecion">]</div>
            </div>
            <h1 class="heading-style-h1">Clear prices for Webflow websites</h1>
            <p class="text-size-medium text-style-allcaps pricing_hero-text">
              Starting prices for new sites, redesigns and migrations, and monthly plans for everything after launch. You get an exact quote after our discovery call.{' '}
              <span class="text-color-alternate">You always work directly with me, the person who builds your site.</span>
            </p>
            <a data-stager-btn href="/contact/" class="button w-inline-block pricing_hero-cta">
              <div data-stager-text>Book a strategy call</div>
            </a>
          </div>

          <div class="pricing_tabs" data-pricing-tabs>
            <!-- Hidden heading: keeps the page outline and names the tab list for screen readers -->
            <h2 class="sr-only" id="plans-heading">Website plans</h2>
            <div class="pricing_tabs-head">
              <!-- Currency switch START -->
              <div class="pricing_tab-list" role="group" aria-label="Currency">
                {
                  currencies.map((c, i) => (
                    <button
                      type="button"
                      class="pricing_tab"
                      data-stager-btn
                      data-currency={c.id}
                      aria-label={c.label}
                      aria-pressed={i === 0 ? 'true' : 'false'}
                    >
                      <span data-stager-text>{c.label}</span>
                    </button>
                  ))
                }
              </div>
              <!-- Currency switch END -->
              <div class="pricing_tab-list" role="tablist" aria-labelledby="plans-heading">
              {
                tabs.map((t, i) => (
                  <button
                    type="button"
                    class="pricing_tab"
                    data-stager-btn
                    aria-label={t.label}
                    role="tab"
                    id={`tab-${t.id}`}
                    aria-controls={`panel-${t.id}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    <span data-stager-text>{t.label}</span>
                  </button>
                ))
              }
              </div>
            </div>

            {
              tabs.map((t, i) => (
                <div
                  class="pricing_panel"
                  role="tabpanel"
                  id={`panel-${t.id}`}
                  aria-labelledby={`tab-${t.id}`}
                  hidden={i !== 0}
                >
                  <ul class="pricing_grid" role="list">
                    {t.plans.map((p) => (
                      <li class:list={['pricing_card', p.featured && 'is-featured']}>
                        <div class="pricing_card-top">
                          <h3 class="heading-style-h5 pricing_card-name">{p.name}</h3>
                          {p.badge && (
                            <span class="pricing_card-badge">
                              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                                <path d="M13.5 2 4 13.5h6.5L9.5 22 20 9.5h-6.5L13.5 2Z" fill="currentColor" />
                              </svg>
                              {p.badge}
                            </span>
                          )}
                          {p.subtitle && <p class="pricing_card-subtitle">{p.subtitle}</p>}
                          <p class="pricing_card-timeline">{p.timeline}</p>
                        </div>
                        <div class="pricing_card-price">
                          {typeof p.price === 'number' && <span class="pricing_card-from">Starting at</span>}
                          <span class="pricing_card-amount">
                            {typeof p.price === 'number' ? (
                              <span>
                                <span class="pricing_card-symbol" data-usd={priceParts(p.price, 'usd').symbol} data-eur={priceParts(p.price, 'eur').symbol} data-gbp={priceParts(p.price, 'gbp').symbol}>
                                  {priceParts(p.price, 'usd').symbol}
                                </span>
                                <span data-usd={priceParts(p.price, 'usd').amount} data-eur={priceParts(p.price, 'eur').amount} data-gbp={priceParts(p.price, 'gbp').amount}>
                                  {priceParts(p.price, 'usd').amount}
                                </span>
                              </span>
                            ) : (
                              p.price
                            )}
                            {p.period && <span class="pricing_card-period">{p.period}</span>}
                          </span>
                        </div>
                        <p class="pricing_card-best">
                          <span class="pricing_card-label">Best for</span>
                          {p.bestFor}
                        </p>
                        <div class="pricing_card-includes">
                          <span class="pricing_card-label">{p.includesLead}</span>
                          <ul class="pricing_card-list" role="list">
                            {p.includes.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        </div>
                        <a
                          data-stager-btn
                          href={p.cta.href}
                          class:list={[
                            'button w-inline-block pricing_card-cta',
                            !p.featured && 'w-variant-d23600a3-4e48-e35d-80a8-3397b31211b0',
                          ]}
                        >
                          <div data-stager-text>{p.cta.label}</div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
        <CornerLines />
      </div>
    </div>
  </section>
  <!-- Pricing hero and plans END -->

  <!-- Plan compare START -->
  <section class="section_plan-compare" aria-labelledby="plan-compare-heading">
    <div class="container-large">
      <div class="side_lines">
        <div class="padding-global padding-section-medium">
          <div class="plan_compare-head">
            <div class="text_in-exprecions">
              <div class="exprecion">[</div>
              <div class="text-color-alternate text-size-regular text-style-allcaps">plans</div>
              <div class="exprecion">]</div>
            </div>
            <h2 class="heading-style-h2" id="plan-compare-heading">Compare the three plans</h2>
          </div>
          <div class="plan_compare-scroll" tabindex="0" role="region" aria-label="Plan comparison, scroll sideways on small screens">
            <span class="plan_compare-fill" aria-hidden="true"></span>
            <table class="plan_compare-table">
              <thead>
                <tr>
                  <th scope="col">Feature</th>
                  {
                    projectPlans.map((plan) => (
                      <th scope="col" class:list={[plan.featured && 'is-featured']}>
                        {plan.name}
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody>
                {
                  planCompareRows.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      {row.values.map((value, i) => (
                        <td class:list={[projectPlans[i].featured && 'is-featured']}>
                          {typeof value === 'number' ? (
                            <span
                              data-usd={Object.values(priceParts(value, 'usd')).join('')}
                              data-eur={Object.values(priceParts(value, 'eur')).join('')}
                              data-gbp={Object.values(priceParts(value, 'gbp')).join('')}
                            >
                              {Object.values(priceParts(value, 'usd')).join('')}
                            </span>
                          ) : value === true ? (
                            <>
                              <svg class="plan_compare-check" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                                <path d="m3 8.5 3.25 3.25L13 5" fill="none" stroke="currentColor" stroke-width="1.5" />
                              </svg>
                              <span class="sr-only">Included</span>
                            </>
                          ) : value === false ? (
                            <>
                              <span class="plan_compare-dash" aria-hidden="true"></span>
                              <span class="sr-only">Not included</span>
                            </>
                          ) : (
                            value
                          )}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
        <CornerLines top={false} />
      </div>
    </div>
  </section>
  <!-- Plan compare END -->

  <RetainerShowcase />

  <ProcessSection />



  <TestimonialsSection testimonials={testimonials} />

  <CtaSection />

  <!-- Pricing FAQ START -->
  <section class="section_faq">
    <div class="container-large">
      <div class="side_lines">
        <div class="padding-global padding-section-large">
          <div class="faq_content">
            <div class="faq_heading-wrapper">
              <div class="heading-style-h2">Frequently asked questions about:</div>
              <h2 class="heading-style-h2">Pricing</h2>
            </div>
            <div class="faq_wrapper">
              {
                pricingFaqs.map((f, i) => (
                  <div id={`faq-blok-${i + 1}`} class="faq_block">
                    <button class="faq_toggle" aria-expanded="false" aria-controls={`faq-answer-${i + 1}`}>
                      <div class="faq_heading-wrap">
                        <h3 class="heading-style-h5">{f.question}</h3>
                      </div>
                      <div class="faq_icon">
                        <div class="faq_minus" />
                        <div class="faq_plus" />
                      </div>
                    </button>
                    <div class="faq_dropdown" id={`faq-answer-${i + 1}`}>
                      <div class="faq_dropdown-inner">
                        <div class="faq_space-block" />
                        <div class="faq_answer-wrapper">
                          <p class="text-size-medium text-style-allcaps">{f.answer}</p>
                        </div>
                        <div class="faq_space-block" />
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <CornerLines />
      </div>
    </div>
  </section>
  <!-- Pricing FAQ END -->
</BaseLayout>

<script>
  /* Pricing tabs START */
  // Accessible tabs: click or arrow keys switch between one-time projects and retainers
  const root = document.querySelector<HTMLElement>('[data-pricing-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    // The plan table compares project plans, so it only shows with the project tab
    const planCompare = document.querySelector<HTMLElement>('.section_plan-compare');
    const select = (tab: HTMLButtonElement, focus = false) => {
      if (planCompare) planCompare.hidden = tab.id !== 'tab-projects';
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    // /pricing/#retainers opens the retainer tab directly (links from other pages)
    const fromHash = tabs.find((t) => t.id === `tab-${location.hash.slice(1)}`);
    if (fromHash) select(fromHash);
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
  }
  /* Pricing tabs END */

  /* Plan compare fill START */
  // Fits the fill to the featured column, whose width depends on the table layout
  const planTable = document.querySelector<HTMLTableElement>('.plan_compare-table');
  const planFill = document.querySelector<HTMLElement>('.plan_compare-fill');
  const featuredHead = planTable?.querySelector<HTMLElement>('thead .is-featured');
  if (planTable && planFill && featuredHead) {
    const placeFill = () => {
      planFill.style.setProperty('--fill-x', `${featuredHead.offsetLeft}px`);
      planFill.style.setProperty('--fill-w', `${featuredHead.offsetWidth}px`);
    };
    // Also runs once on load, and when the table reappears on the project tab
    new ResizeObserver(placeFill).observe(planTable);
    // Column widths change without the table resizing when the web fonts arrive
    void document.fonts.ready.then(placeFill);
  }
  /* Plan compare fill END */

  /* Currency switch START */
  // Both prices are rendered on each card, the switch only swaps the visible one
  const currencyButtons = document.querySelectorAll<HTMLButtonElement>('[data-currency]');
  const prices = document.querySelectorAll<HTMLElement>('[data-usd]');
  currencyButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const currency = button.dataset.currency as 'usd' | 'eur' | 'gbp';
      root?.setAttribute('data-active-currency', currency);
      currencyButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      prices.forEach((price) => {
        price.textContent = price.dataset[currency] ?? '';
      });
    });
  });
  /* Currency switch END */

  /* Pricing FAQ accordion START */
  // Same open/close behavior as the resource FAQ, styles live in app.css
  document.querySelectorAll<HTMLElement>('.section_faq .faq_block').forEach((block) => {
    const toggle = block.querySelector<HTMLButtonElement>('.faq_toggle');
    toggle?.addEventListener('click', () => {
      const open = block.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  });
  /* Pricing FAQ accordion END */
</script>
