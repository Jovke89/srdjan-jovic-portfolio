---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaxonomyList from '../../components/TaxonomyList.astro';
import { TECH_SLUGS_QUERY, TECH_PAGE_QUERY } from '../../lib/sanity/queries';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(TECH_SLUGS_QUERY);
  return (slugs ?? []).map((s: { slug: string }) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const data = await sanityClient.fetch(TECH_PAGE_QUERY, { slug });
if (!data) return Astro.redirect('/404');
---
<BaseLayout seo={{ title: 'Srdjan Jovic Portfolio' }}>
  <TaxonomyList kicker="tech stack" title={data.name} caseStudies={data.caseStudies ?? []} cta="view Case Study" />
</BaseLayout>
