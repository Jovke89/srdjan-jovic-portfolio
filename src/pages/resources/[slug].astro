                    <a data-share="linkedin" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" class="icon_circle w-inline-block" aria-label="Share on LinkedIn">
