---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CornerLines from '../../components/CornerLines.astro';
import GameStars from '../../components/GameStars.astro';
import GameRelated from '../../components/GameRelated.astro';
---

<BaseLayout
  seo={{
    title: 'SRDJAN JOVIC · Agent Pinball',
    description: 'A pinball table built around the AI agent. Hit the robot bumpers, spell SRDJAN and raise the multiplier.',
    ogImage: new URL('/og/game-room.jpg', Astro.site).href,
  }}
>
  <GameStars />

  <!-- Pinball game START -->
  <section class="section_game">
    <div class="container-large">
      <div class="side_lines">
        <div class="padding-global padding-section-large">
          <div class="game_component">
            <div class="game_header">
              <div class="game_header-meta">
                <a href="/game-room/" class="bak_to-all-posts">&lt; game room</a>
                <div class="text_in-exprecions">
                  <div class="exprecion">[</div>
                  <div class="text-color-alternate text-size-regular text-style-allcaps">game 01</div>
                  <div class="exprecion">]</div>
                </div>
              </div>
              <h1 class="heading-style-h1">Agent Pinball</h1>
              <p class="text-size-medium text-style-allcaps">
                Keep the ball alive. The bumpers are the AI agent, the posts, springs and slingshots kick
                back, and the six lanes at the top spell SRDJAN. Light them all to raise the multiplier,
                30 bumper hits earn an extra ball. Nudge the table, but not too often.
              </p>
            </div>

            <p class="game-room_mobile-note text-size-medium text-style-allcaps">
              Agent Pinball needs a keyboard. Open this page on a desktop to play.
            </p>

            <div class="game_board" data-pinball>
              <div class="game_hud text-size-regular text-style-allcaps" aria-live="polite">
                <div>score <span class="text-color-alternate" data-game-score>0</span></div>
                <div>ball <span class="text-color-alternate" data-game-ball>1/3</span></div>
                <div>multiplier <span class="text-color-alternate" data-game-mult>x1</span></div>
                <div>best <span class="text-color-alternate" data-game-best>0</span></div>
              </div>
              <div class="game_screen">
                <canvas class="game_canvas" data-game-canvas role="img" aria-label="Agent Pinball game board"></canvas>
                <div class="game_overlay" data-game-overlay>
                  <h2 class="heading-style-h3" data-game-title>Ready?</h2>
                  <p class="text-size-regular text-style-allcaps" data-game-text>
                    Left and right arrows for the flippers, hold space to launch, up to nudge, P to pause.
                  </p>
                  <button type="button" data-stager-btn class="button" data-game-start>
                    <div data-stager-text>Play</div>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <CornerLines />
        </div>
      </div>
    </div>
  </section>
  <!-- Pinball game END -->

  <GameRelated current="pinball" />
</BaseLayout>

<script>
  import '../../scripts/pinball.ts';
</script>
