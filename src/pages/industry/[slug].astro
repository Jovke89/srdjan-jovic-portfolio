---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaxonomyList from '../../components/TaxonomyList.astro';
import { INDUSTRY_SLUGS_QUERY, INDUSTRY_PAGE_QUERY } from '../../lib/sanity/queries';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(INDUSTRY_SLUGS_QUERY);
  return (slugs ?? []).map((s: { slug: string }) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const data = await sanityClient.fetch(INDUSTRY_PAGE_QUERY, { slug });
if (!data) return Astro.redirect('/404');
---
<BaseLayout seo={{ title: `${data.name} — Webflow case studies | Srdjan Jovic`, noindex: true }}>
  <TaxonomyList kicker="industry" title={data.name} caseStudies={data.caseStudies ?? []} cta="view Case Study" />
</BaseLayout>
