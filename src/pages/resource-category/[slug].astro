---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaxonomyList from '../../components/TaxonomyList.astro';
import { CATEGORY_SLUGS_QUERY, CATEGORY_PAGE_QUERY } from '../../lib/sanity/queries';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(CATEGORY_SLUGS_QUERY);
  return (slugs ?? []).map((s: { slug: string }) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const data = await sanityClient.fetch(CATEGORY_PAGE_QUERY, { slug });
if (!data) return Astro.redirect('/404');

const seo = {
  title: `${data.name} — Webflow & automation resources | Srdjan Jovic`,
  description: `${data.name} articles and guides from Srdjan Jovic, a Webflow developer and Make automation specialist.`,
};
---
<BaseLayout seo={seo}>
  <TaxonomyList kicker="category" title={data.name} resources={data.resources ?? []} cta="read article" />
</BaseLayout>
