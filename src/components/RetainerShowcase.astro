---
/* What you get with a retainer: figures stand in a line that fades into the distance on the left.
   The front figure is the active feature; arrows, drag, keys or a click on a figure walk the line.
   The panel on the right shows what the active feature is and why it matters. */
import CheckMark from './CheckMark.astro';
import { retainerFeatures } from '../lib/pricing';

const pad = (n: number) => String(n).padStart(2, '0');
const total = retainerFeatures.length;
---

<!-- Retainer showcase START -->
<section class="section_retainer" aria-labelledby="retainer-heading">
  <div class="container-large">
    <div class="side_lines">
      <div class="padding-global padding-section-medium">
        <div class="retainer_layout" data-retainer>
          <div
            class="retainer_stage"
            data-retainer-stage
            tabindex="0"
            role="group"
            aria-roledescription="carousel"
            aria-label="Retainer features. Use the arrow buttons, arrow keys or drag to change."
          >
            <div class="retainer_line" data-retainer-line>
              {
                retainerFeatures.map((f, i) => (
                  <div class="retainer_figure" data-figure={i} aria-hidden="true">
                    <picture>
                      <source srcset={f.image.avif} type="image/avif" />
                      <img src={f.image.webp} alt="" width="800" height="800" loading="lazy" decoding="async" draggable="false" />
                    </picture>
                  </div>
                ))
              }
            </div>

            <div class="retainer_drag-cursor" data-retainer-cursor aria-hidden="true">
              <span class="retainer_drag-pill" data-retainer-pill>
                <!-- Lightning bolt, like Zeus summoning the next god -->
                <svg viewBox="0 0 24 24" width="16" height="16">
                  <path d="M13.5 2 4 13.5h6.5L9.5 22 20 9.5h-6.5L13.5 2Z" fill="currentColor"></path>
                </svg>
                <span>Drag your god</span>
              </span>
            </div>

            <div class="retainer_intro">
              <div class="text_in-exprecions">
                <div class="exprecion">[</div>
                <div class="text-color-alternate text-size-regular text-style-allcaps">retainer</div>
                <div class="exprecion">]</div>
              </div>
              <h2 id="retainer-heading" class="heading-style-h3">What you get with a retainer</h2>
              <p class="text-size-regular text-style-allcaps retainer_intro-text">
                One person who knows your site inside out, working on it every month.
              </p>
            </div>

            <div class="retainer_bottom">
              <div class="retainer_counter" aria-hidden="true">
                <span data-retainer-index>01</span> / {pad(total)}
              </div>
              <div class="retainer_name-window" aria-live="polite">
                <span class="sr-only" data-retainer-live>{retainerFeatures[0].name}</span>
                <div class="retainer_name-roll" data-retainer-roll aria-hidden="true">
                  {[...retainerFeatures, retainerFeatures[0]].map((f) => <span>{f.name}</span>)}
                </div>
              </div>
              <div class="retainer_arrows">
                <button type="button" class="retainer_arrow" data-retainer-prev aria-label="Previous feature">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                </button>
                <button type="button" class="retainer_arrow" data-retainer-next aria-label="Next feature">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                </button>
              </div>
            </div>
          </div>

          <div class="retainer_panel">
            {
              retainerFeatures.map((f, i) => (
                <div class="retainer_panel-item" data-panel={i} hidden={i !== 0}>
                  <span class="retainer_plan">{f.plans}</span>
                  <h3 class="heading-style-h5 retainer_panel-title">{f.name}</h3>
                  <div class="retainer_panel-block">
                    <span class="retainer_label">What it is</span>
                    <p>{f.what}</p>
                  </div>
                  <div class="retainer_panel-block">
                    <span class="retainer_label">Why it matters for your site</span>
                    <p>{f.why}</p>
                  </div>
                  <ul class="retainer_points" role="list">
                    {f.points.map((pt) => (
                      <li>
                        <CheckMark yes={true} />
                        <span>{pt}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
            <a data-stager-btn href="/contact/" class="button w-inline-block retainer_cta">
              <div data-stager-text>Book a strategy call</div>
            </a>
          </div>
        </div>
      </div>
      <div class="lines_absoulute-position is-right-tbottom">
        <div class="lines_wrapper"><div class="line"></div><div class="line is-vertical"></div></div>
      </div>
      <div class="lines_absoulute-position is-left-bottom">
        <div class="lines_wrapper"><div class="line"></div><div class="line is-vertical"></div></div>
      </div>
    </div>
  </div>
</section>
<!-- Retainer showcase END -->

<script>
  /* Retainer showcase START */
  // One float (p) drives every figure: depth d = wrap(i - p) decides position, size, blur and opacity
  // from the stop tables below (depth -1 = leaving on the right, 4 = arriving from the haze).
  const root = document.querySelector<HTMLElement>('[data-retainer]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-retainer-stage]')!;
    const figures = Array.from(root.querySelectorAll<HTMLElement>('[data-figure]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const roll = root.querySelector<HTMLElement>('[data-retainer-roll]')!;
    const live = root.querySelector<HTMLElement>('[data-retainer-live]')!;
    const indexEl = root.querySelector<HTMLElement>('[data-retainer-index]')!;
    const names = panels.map((p) => p.querySelector('h3')?.textContent ?? '');
    const N = figures.length;
    const RATIO = 1; // every figure sits on a square canvas

    // Depth stops for d = -1, 0, 1, 2, 3, 4 (fractions of stage width / height)
    const KX = [1.12, 0.7, 0.49, 0.35, 0.24, 0.16];
    const KF = [1.04, 1.0, 0.9, 0.84, 0.8, 0.77];
    const KH = [0.98, 0.8, 0.54, 0.41, 0.32, 0.24];
    const KB = [0, 0, 2, 5, 9, 13];
    const KO = [0, 1, 0.95, 0.72, 0.42, 0];

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wrap = (x: number, n: number) => ((x % n) + n) % n;
    const pad = (n: number) => String(n).padStart(2, '0');

    let W = 0;
    let H = 0;
    let p = 0;
    let target = 0;
    let active = 0;
    let dirty = true;
    let last = 0;
    let running = false;
    const state = figures.map(() => ({ f: '', o: '' }));

    // Shrink the name font just enough that the longest feature name fits in full, never cut
    const nameWindow = roll.parentElement!;
    const fitNames = () => {
      roll.style.fontSize = '';
      const spans = Array.from(roll.children) as HTMLElement[];
      const widest = Math.max(...spans.map((s) => s.scrollWidth));
      const room = nameWindow.clientWidth;
      if (widest > room && room > 0) {
        const base = parseFloat(getComputedStyle(roll).fontSize);
        roll.style.fontSize = `${Math.floor(base * (room / widest) * 100) / 100}px`;
      }
    };

    const size = () => {
      W = stage.clientWidth;
      H = stage.clientHeight;
      fitNames();
      figures.forEach((el) => {
        el.style.width = `${H * RATIO}px`;
        el.style.height = `${H}px`;
      });
      dirty = true;
      kick();
    };

    const paint = () => {
      figures.forEach((el, i) => {
        let d = wrap(i - p, N);
        if (d > N - 1) d -= N;
        const k = Math.min(5, Math.max(0, d + 1));
        const a = Math.floor(k);
        const b = Math.min(5, a + 1);
        const t = k - a;
        const mix = (A: number[]) => A[a] + (A[b] - A[a]) * t;
        // Phones: figures a bit smaller so the front one stays clear of the heading
        const h = mix(KH) * H * (W < 480 ? 0.8 : 1);
        const s = h / H;
        const w = h * RATIO;
        const x = mix(KX) * W - w / 2;
        const y = mix(KF) * H - h;
        el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${s.toFixed(4)})`;
        // Blur is divided by the scale so it looks the same on screen at every depth
        const blur = mix(KB) / s;
        const f = blur < 0.2 ? 'none' : `blur(${blur.toFixed(1)}px)`;
        const o = mix(KO).toFixed(3);
        if (f !== state[i].f) el.style.filter = state[i].f = f;
        if (o !== state[i].o) el.style.opacity = state[i].o = o;
        el.style.zIndex = String(100 - Math.round(d * 10));
        el.classList.toggle('is-front', Math.abs(d) < 0.5);
      });
      const lineH = roll.firstElementChild instanceof HTMLElement ? roll.firstElementChild.offsetHeight : 0;
      roll.style.transform = `translate3d(0, ${(-wrap(p, N) * lineH).toFixed(1)}px, 0)`;

      const now = wrap(Math.round(p), N);
      if (now !== active) {
        active = now;
        panels.forEach((el, i) => (el.hidden = i !== active));
        live.textContent = names[active];
        indexEl.textContent = pad(active + 1);
      }
    };

    // The loop only runs while p is moving, so an idle section costs nothing
    const frame = (time: number) => {
      const dt = Math.min(50, time - last) || 16;
      last = time;
      if (reduce.matches) p = target;
      else p += (target - p) * (1 - Math.exp(-dt * 0.0072));
      if (Math.abs(target - p) < 0.0004) p = target;
      paint();
      dirty = false;
      if (p !== target) requestAnimationFrame(frame);
      else running = false;
    };
    function kick() {
      if (running) return;
      if (p === target && !dirty) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    }
    const go = (step: number) => {
      target = Math.round(target) + step;
      kick();
    };

    root.querySelector('[data-retainer-prev]')?.addEventListener('click', () => go(-1));
    root.querySelector('[data-retainer-next]')?.addEventListener('click', () => go(1));
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    });

    // Drag walks the line, release snaps to the nearest feature; a short press on a back figure jumps to it
    let down = false;
    let sx = 0;
    let st = 0;
    let moved = 0;
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button, a')) return;
      down = true;
      sx = e.clientX;
      st = target;
      moved = 0;
      // Capture can fail when the pointer is already gone (synthetic or cancelled events), dragging still works
      try {
        stage.setPointerCapture(e.pointerId);
      } catch {
        /* pointer no longer active */
      }
      stage.classList.add('is-dragging');
    });
    stage.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      moved = Math.max(moved, Math.abs(dx));
      // Dragging right pulls the line forward, like walking toward the viewer
      target = st + dx / Math.max(150, W * 0.25);
      kick();
    });
    const release = (e: PointerEvent) => {
      if (!down) return;
      down = false;
      stage.classList.remove('is-dragging');
      if (moved < 6) {
        const hit = document
          .elementsFromPoint(e.clientX, e.clientY)
          .find((el) => el instanceof HTMLElement && el.dataset.figure !== undefined) as HTMLElement | undefined;
        if (hit) {
          const d = Math.round(wrap(Number(hit.dataset.figure) - target, N));
          if (d > 0 && d < N) target = Math.round(target) + d;
        }
      } else {
        target = Math.round(target);
      }
      kick();
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);

    /* Drag cursor START */
    // Mouse only: a "Drag" pill with a hand follows the pointer over the stage, hidden over the arrows
    const cursor = root.querySelector<HTMLElement>('[data-retainer-cursor]');
    const pill = root.querySelector<HTMLElement>('[data-retainer-pill]');
    if (cursor && pill && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      // The pill stretches in and out (CSS keyframes); only flip classes when the state really changes
      let shown = false;
      const showPill = (on: boolean) => {
        if (on === shown) return;
        shown = on;
        pill.classList.toggle('is-in', on);
        pill.classList.toggle('is-out', !on);
      };
      let mx = 0;
      let my = 0;
      let cx = 0;
      let cy = 0;
      let follow = 0;
      const move = () => {
        const k = reduce.matches ? 1 : 0.25;
        cx += (mx - cx) * k;
        cy += (my - cy) * k;
        cursor.style.transform = `translate3d(${cx.toFixed(1)}px, ${cy.toFixed(1)}px, 0)`;
        follow = Math.abs(mx - cx) + Math.abs(my - cy) > 0.3 ? requestAnimationFrame(move) : 0;
      };
      stage.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = stage.getBoundingClientRect();
        cx = mx = e.clientX - r.left;
        cy = my = e.clientY - r.top;
        move();
        stage.classList.add('has-drag-cursor');
        showPill(true);
      });
      stage.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = stage.getBoundingClientRect();
        mx = e.clientX - r.left;
        my = e.clientY - r.top;
        // No pill anywhere on the arrows block (buttons and the gap between them) or on links
        showPill(!(e.target as HTMLElement).closest('.retainer_arrows, button, a'));
        if (!follow) follow = requestAnimationFrame(move);
      });
      stage.addEventListener('pointerleave', () => {
        stage.classList.remove('has-drag-cursor');
        showPill(false);
        // Keep following until the exit stretch has played, then stop
        window.setTimeout(() => {
          if (shown) return;
          cancelAnimationFrame(follow);
          follow = 0;
        }, 400);
      });
    }
    /* Drag cursor END */

    new ResizeObserver(size).observe(stage);
    size();
    // Fonts change text width, so measure again once they are loaded
    document.fonts?.ready.then(size);
  }
  /* Retainer showcase END */
</script>
