---
/* GDPR-style cookie consent banner, rendered once site-wide from
   BaseLayout.astro. Gates Google Analytics — see Analytics.astro for the
   loading side of this (it waits for the `cookieconsent:accepted` event
   this banner dispatches, and never loads GA4 on decline).

   Two panels toggled via [hidden]: the main view (Accept All / Reject All /
   Customise) and a customise view with a single real toggle (Analytics —
   Necessary cookies are always on and can't be switched off). Buttons reuse
   the site's real button classes/markup so they get the same allcaps style
   and [data-stager-text] hover roll animation as every other button. */
---

<div id="cookie-consent" class="cookie-consent" hidden role="dialog" aria-live="polite" aria-label="Cookie consent">
  <div class="cookie-consent_inner">
    <div class="cookie-consent_panel" data-cookie-panel="main">
      <h2 class="cookie-consent_heading">I value your privacy</h2>
      <p class="cookie-consent_text">
        I use cookies to enhance your browsing experience and analyse site traffic. By clicking "Accept All", you
        consent to this.
      </p>
      <div class="cookie-consent_actions">
        <button type="button" data-cookie-action="customise" data-stager-btn class="button w-variant-d23600a3-4e48-e35d-80a8-3397b31211b0">
          <div data-stager-text>Customise</div>
        </button>
        <button type="button" data-cookie-action="reject" data-stager-btn class="button w-variant-d23600a3-4e48-e35d-80a8-3397b31211b0">
          <div data-stager-text>Reject All</div>
        </button>
        <button type="button" data-cookie-action="accept" data-stager-btn class="button">
          <div data-stager-text>Accept All</div>
        </button>
      </div>
    </div>

    <div class="cookie-consent_panel" data-cookie-panel="customise" hidden>
      <h2 class="cookie-consent_heading">Customise cookie preferences</h2>

      <div class="cookie-consent_category">
        <div class="cookie-consent_category-header">
          <span class="cookie-consent_category-title">Necessary</span>
          <span class="cookie-consent_always-on">Always active</span>
        </div>
        <p class="cookie-consent_category-desc">Required for the site to work. These can't be switched off.</p>
      </div>

      <div class="cookie-consent_category">
        <div class="cookie-consent_category-header">
          <span class="cookie-consent_category-title">Analytics</span>
          <label class="cookie-consent_switch">
            <input type="checkbox" id="cookie-consent-analytics-toggle" />
            <span class="cookie-consent_switch-track"><span class="cookie-consent_switch-thumb"></span></span>
          </label>
        </div>
        <p class="cookie-consent_category-desc">
          Google Analytics helps me see how visitors find and use this site. No data is sold or shared with third
          parties.
        </p>
      </div>

      <div class="cookie-consent_actions">
        <button type="button" data-cookie-action="back" data-stager-btn class="button w-variant-d23600a3-4e48-e35d-80a8-3397b31211b0">
          <div data-stager-text>Back</div>
        </button>
        <button type="button" data-cookie-action="save" data-stager-btn class="button">
          <div data-stager-text>Save Preferences</div>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import '../scripts/cookie-consent.ts';
</script>

<style>
  /* Cookie consent banner START */
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    /* Below .loading-container (z-index: 9999) so the intro loader always
       covers the banner instead of the other way around. */
    z-index: 999;
    padding: 2.5rem clamp(1rem, 0.5rem + 2.083vw, 2.5rem) 2.75rem;
    background: var(--_srdjan-variables---bg-color);
    border-top: 1px solid var(--_srdjan-variables---border-color);
    /* Slides up on open, back down on close/accept/reject — see
       cookie-consent.ts, which toggles .is-open a frame after unhiding and
       waits for this transition to finish before re-hiding. */
    transform: translateY(100%);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cookie-consent.is-open {
    transform: translateY(0);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent {
      transition: none;
    }
  }

  .cookie-consent_inner {
    max-width: 75rem;
    margin: 0 auto;
  }

  .cookie-consent_panel[hidden] {
    display: none;
  }

  .cookie-consent_heading {
    margin: 0 0 0.5rem;
    font-family: var(--_srdjan-variables---heading-type-face);
    font-size: 1.75rem;
    color: var(--_srdjan-variables---heading-color);
  }

  .cookie-consent_text {
    margin: 0 0 1.25rem;
    max-width: 48rem;
    font-family: var(--_srdjan-variables---body-text-type-face);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--_srdjan-variables---body-text-color);
  }

  .cookie-consent_actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cookie-consent_actions .button {
    margin-top: 0;
  }

  .cookie-consent_category {
    padding: 1rem 0;
    border-top: 1px solid var(--_srdjan-variables---border-color);
  }

  .cookie-consent_category:last-of-type {
    margin-bottom: 1.25rem;
  }

  .cookie-consent_category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .cookie-consent_category-title {
    font-family: var(--_srdjan-variables---heading-type-face);
    font-size: 1.15rem;
    color: var(--_srdjan-variables---heading-color);
  }

  .cookie-consent_always-on {
    font-family: var(--_srdjan-variables---body-text-type-face);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--_srdjan-variables---brand-color);
  }

  .cookie-consent_category-desc {
    margin: 0.4rem 0 0;
    max-width: 42rem;
    font-family: var(--_srdjan-variables---body-text-type-face);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--_srdjan-variables---body-text-color);
  }

  /* Toggle switch */
  .cookie-consent_switch {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    cursor: pointer;
  }

  .cookie-consent_switch input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }

  .cookie-consent_switch-track {
    width: 2.75rem;
    height: 1.5rem;
    border-radius: 1rem;
    background: var(--_srdjan-variables---card-bg-color);
    border: 1px solid var(--_srdjan-variables---border-color);
    display: flex;
    align-items: center;
    padding: 0.1rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .cookie-consent_switch-thumb {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--_srdjan-variables---body-text-color);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .cookie-consent_switch input:checked + .cookie-consent_switch-track {
    background: var(--_srdjan-variables---brand-color);
    border-color: var(--_srdjan-variables---brand-color);
  }

  .cookie-consent_switch input:checked + .cookie-consent_switch-track .cookie-consent_switch-thumb {
    transform: translateX(1.25rem);
    background: var(--_srdjan-variables---bg-color);
  }

  .cookie-consent_switch input:focus-visible + .cookie-consent_switch-track {
    outline: 2px solid var(--base-color-system--focus-state);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent_switch-track,
    .cookie-consent_switch-thumb {
      transition: none;
    }
  }

  @media (max-width: 479px) {
    .cookie-consent_actions {
      flex-direction: column;
      align-items: stretch;
    }

    .cookie-consent_actions .button {
      width: 100%;
    }
  }
  /* Cookie consent banner END */
</style>
