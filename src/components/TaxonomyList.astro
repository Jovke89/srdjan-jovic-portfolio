---
/* Minimal taxonomy page body: a heading + a grid of related cards.
   Matches the empty Webflow stub templates (fallback title, no JSON-LD/OG). */
import CornerLines from './CornerLines.astro';
import ProjectCard from './ProjectCard.astro';
import ResourceCard from './ResourceCard.astro';

interface Props {
  kicker: string;
  title: string;
  caseStudies?: any[];
  resources?: any[];
  cta: string;
}
const { kicker, title, caseStudies = [], resources = [], cta } = Astro.props;
---

<section class="section_hero-projects">
  <div class="container-large">
    <div class="side_lines">
      <div class="padding-global padding-section-large">
        <div class="projects_content-wrapper">
          <div class="projects_heading-wrapper">
            <div class="projects_heading">
              <div class="text_in-exprecions">
                <div class="exprecion">[</div>
                <div class="text-color-alternate text-size-regular text-style-allcaps">{kicker}</div>
                <div class="exprecion">]</div>
              </div>
              <h1 class="heading-style-h2">{title}</h1>
            </div>
          </div>

          {
            caseStudies.length > 0 && (
              <div class="projects_list-wrapper w-dyn-list">
                <div role="list" class="projects_list w-dyn-items">
                  {caseStudies.map((c) => (
                    <ProjectCard
                      href={`/case-studies/${c.slug}`}
                      title={c.name}
                      text={c.clientDescription}
                      image={c.cardThumbnail}
                      cta={cta}
                    />
                  ))}
                </div>
              </div>
            )
          }

          {
            resources.length > 0 && (
              <div class="resources_grid w-dyn-list">
                <div role="list" class="collection-list-2 w-dyn-items">
                  {resources.map((r) => (
                    <ResourceCard resource={r} variant="grid" />
                  ))}
                </div>
              </div>
            )
          }

          {caseStudies.length === 0 && resources.length === 0 && (
            <p class="text-size-medium text-style-allcaps">Nothing here yet.</p>
          )}

          <CornerLines />
        </div>
      </div>
    </div>
  </div>
</section>
