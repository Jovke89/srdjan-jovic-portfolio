---
import { imgSet } from '../lib/sanity/image';

interface Props {
  src?: string | null;
  poster?: unknown;
}
const { src, poster } = Astro.props;
const posterUrl = imgSet(poster, { width: 1200 })?.src;
---

<div class="video_palyer w-embed">
  <div
    class="video-wrap"
    data-src={src ?? ''}
    style="position:relative; width:100%; aspect-ratio:16/9; background:#000; cursor:pointer;"
  >
    <video
      class="video-el"
      poster={posterUrl}
      preload="none"
      playsinline
      style="width:100%; height:100%; object-fit:cover; display:block;"></video>
    <div
      class="vid-spinner"
      style="display:none; position:absolute; inset:0; align-items:center; justify-content:center; pointer-events:none;"
    >
      <div
        style="width:48px; height:48px; border:4px solid rgba(255,255,255,0.3); border-top-color:#fff; border-radius:50%; animation:spin 0.8s linear infinite;"
      >
      </div>
    </div>
    <div
      class="vid-btn"
      style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; transition:opacity 0.2s;"
    >
      <div
        style="width:64px; height:64px; border-radius:50%; background:rgba(255,255,255,0.9); display:flex; align-items:center; justify-content:center;"
      >
        <svg class="vid-icon" width="24" height="24" viewBox="0 0 24 24" fill="#000">
          <polygon points="6,4 20,12 6,20"></polygon>
        </svg>
      </div>
    </div>
  </div>
  <style is:global>
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>
</div>
