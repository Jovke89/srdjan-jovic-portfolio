---
/* Shared footer. Markup preserved from the Webflow export. */
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-large">
    <div class="side_lines">
      <div class="padding-global footer-padding">
        <div class="footer_content-wrapper">
          <div class="footer_header">
            <div class="footer_heading-wrapper">
              <div class="text_in-exprecions">
                <div class="exprecion">[</div>
                <div class="text-color-alternate text-size-regular text-style-allcaps">get in touch</div>
                <div class="exprecion">]</div>
              </div>
              <div class="footer_heading">
                <h2 class="heading-style-h1">Say hi!<br />Let’s talk</h2>
              </div>
            </div>
            <div class="footer_btn-wrapper">
              <a href="/contact" class="footer_btn w-inline-block">
                <div class="text-block">CONTACT ME</div>
              </a>
            </div>
          </div>
          <div class="footer-links-wrapper">
            <div class="footer_links">
              <div class="main_links">
                <a href="/" class="footer_lik text-size-medium text-style-allcaps">home</a>
                <a href="/case-studies" class="footer_lik text-size-medium text-style-allcaps">case studies</a>
                <a href="/resources" class="footer_lik text-size-medium text-style-allcaps">resources</a>
                <a href="/events" class="footer_lik text-size-medium text-style-allcaps">events</a>
              </div>
              <div class="social_networks">
                <a href="https://www.linkedin.com/in/srdjanjovic" target="_blank" rel="noopener" class="footer_lik text-size-medium text-style-allcaps">linkedin</a>
                <a href="https://www.instagram.com/flowmagiaa/" target="_blank" rel="noopener" class="footer_lik text-size-medium text-style-allcaps hide">instagram</a>
              </div>
            </div>
            <div class="section_divider footre-divider"></div>
            <div class="copy_wrapper">
              <div class="text-size-small text-style-allcaps">
                © <span id="currentYear" class="current_year">{year}</span> Srdjan jovic. webflow developer
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
