---
/* Shared navbar. Markup preserved from the Webflow export (w-nav classes kept).
   webflow.js is not used; the collapse/hamburger is rebuilt below. */
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { label: 'HOme', href: '/' },
  { label: 'CASE STUDIES', href: '/case-studies' },
  { label: 'resources', href: '/resources' },
  { label: 'Events', href: '/events' },
];

function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="sticky_nav-component">
  <div
    data-animation="over-right"
    data-collapse="medium"
    data-duration="400"
    data-easing="ease"
    data-easing2="ease"
    role="banner"
    class="navbar_component w-nav"
  >
    <div class="padding-global nav_padding">
      <div class="container-large nav_container">
        <a
          aria-label="logo"
          href="/"
          class:list={['brand_logo-wrapper', 'w-nav-brand', isCurrent('/') && 'w--current']}
          aria-current={isCurrent('/') ? 'page' : undefined}
        >
          <div class="svg_icon-code w-embed"><Logo /></div>
        </a>
        <nav role="navigation" class="nav_links-wrapper w-nav-menu" id="nav-menu">
          <ul role="list" class="nav_links-list">
            {
              links.map((l) => (
                <li class="nav_list-link">
                  <a
                    href={l.href}
                    class:list={['nav_link', 'blink-btn', 'w-inline-block', isCurrent(l.href) && 'w--current']}
                    aria-current={isCurrent(l.href) ? 'page' : undefined}
                  >
                    <div class="exprecion">[</div>
                    <div class="button_text-blink">{l.label}</div>
                    <div class="exprecion">]</div>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="button_mobile">
            <a data-stager-btn data-wf--button--variant="base" href="/contact" class="button w-inline-block">
              <div data-stager-text>Contact me</div>
            </a>
          </div>
        </nav>
        <div class="button_desctiop">
          <a data-stager-btn data-wf--button--variant="base" href="/contact" class="button w-inline-block">
            <div data-stager-text>Contact me</div>
          </a>
        </div>
        <button class="menu_hamburger w-nav-button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
          {/* 3 plain bars instead of the Webflow icon-font glyph, so they can
              morph into an X on open (a font glyph can't be animated like this). */}
          <div class="icon hamburger_icon">
            <span class="hamburger_bar"></span>
            <span class="hamburger_bar"></span>
            <span class="hamburger_bar"></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Rebuild the Webflow w-nav collapse (medium breakpoint = 991px) without webflow.js.
  const nav = document.querySelector<HTMLElement>('.navbar_component');
  const menu = document.querySelector<HTMLElement>('.w-nav-menu');
  const button = document.querySelector<HTMLButtonElement>('.menu_hamburger');
  const BP = 991;
  // Reuse the duration/easing already authored on the navbar (Webflow's own
  // data-duration/data-easing attributes) instead of a second hardcoded value.
  const DURATION = Number(nav?.dataset.duration) || 400;
  const EASING = nav?.dataset.easing || 'ease';
  const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  function isOpen() {
    return button?.classList.contains('w--open');
  }
  function setOpen(open: boolean) {
    if (!menu || !button) return;
    clearTimeout(closeTimer);
    button.classList.toggle('w--open', open);
    // Webflow's own CSS shows/hides `.w-nav-menu` off the `data-nav-menu-open`
    // attribute (see `[data-nav-menu-open]` in webflow.css) with `display:
    // block !important` and no transition. The panel is anchored to the right
    // edge (`data-animation="over-right"`, and `position: fixed; right: 0` in
    // app.css) — slide it in from there manually via inline transform, and
    // only for the open/closing window: keeping it laid out at all times (an
    // earlier attempt, via a permanent CSS transform) broke touch scrolling
    // on mobile, so the attribute goes on right before sliding in and comes
    // off only once the slide-out has actually finished.
    if (open) {
      menu.setAttribute('data-nav-menu-open', '');
      if (!reducedMotion()) {
        menu.style.transition = 'none';
        menu.style.transform = 'translateX(100%)';
        void menu.offsetWidth; // force layout so the line above paints before animating
        menu.style.transition = `transform ${DURATION}ms ${EASING}`;
      }
      menu.style.transform = 'translateX(0)';
    } else if (!reducedMotion()) {
      menu.style.transition = `transform ${DURATION}ms ${EASING}`;
      menu.style.transform = 'translateX(100%)';
      closeTimer = setTimeout(() => {
        menu.removeAttribute('data-nav-menu-open');
        menu.style.transition = '';
        menu.style.transform = '';
      }, DURATION);
    } else {
      menu.removeAttribute('data-nav-menu-open');
    }
    menu.classList.toggle('w--nav-menu-open', open);
    menu.classList.toggle('w--open', open);
    nav?.classList.toggle('w--open', open);
    button.setAttribute('aria-expanded', String(open));
    // No separate body class to manage from here — app.css locks scroll via
    // `body:has(.menu_hamburger.w--open)`, off the class already toggled
    // 3 lines up.
    if (open && (window as any).lenis) (window as any).lenis.stop();
    else if ((window as any).lenis) (window as any).lenis.start();
  }

  button?.addEventListener('click', () => setOpen(!isOpen()));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      button?.focus();
    }
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      if (isOpen()) setOpen(false);
    }),
  );
  window.addEventListener('resize', () => {
    if (window.innerWidth > BP && isOpen()) setOpen(false);
  });
</script>
