# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key, safe for the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key, server only, used by client link actions and MCP tools
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bearer token for the MCP server on localhost (generate a long random string)
MCP_API_KEY=replace-with-a-long-random-string

# Secret that Vercel Cron sends to /api/keepalive
CRON_SECRET=replace-with-a-long-random-string

# Secret used to sign the client link visitor name cookie
LINK_COOKIE_SECRET=replace-with-a-long-random-string
